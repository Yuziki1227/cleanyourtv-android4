<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family.
     API 26+ gets the bundled Outfit through values-v26/fonts.xml; Android 4.0-5.1 get a system family
     here because TextView's fontFamily cannot resolve res/font before API 26. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">sans-serif</string>
    <string name="font_regular" translatable="false">sans-serif</string>
    <string name="font_light" translatable="false">sans-serif</string>
    <string name="font_extralight" translatable="false">sans-serif</string>
    <string name="font_medium" translatable="false">sans-serif</string>
</resources>
